<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target so consumers on modern .NET and on .NET Framework both get a
         supported build. The pinning implementation is identical for both. -->
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <!-- Preserve the existing output assembly and root namespace so the embedded
         resource logical name (duo_api_csharp.ca_certs.pem) and consumers are unchanged. -->
    <AssemblyName>ClassLibrary</AssemblyName>
    <RootNamespace>duo_api_csharp</RootNamespace>
    <!-- AssemblyInfo.cs still supplies the assembly attributes (incl. InternalsVisibleTo). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ca_certs.pem" />
  </ItemGroup>

  <!-- System.Text.Json, System.Configuration and System.Web are in-box on net8.0;
       on .NET Framework they must be referenced explicitly. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="6.0.10" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web" />
  </ItemGroup>

  <!-- ConfigurationManager (AppSettings) is provided by this package on modern .NET. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

</Project>
